# Mẫu Django production. Sao chép thành .env.production và thay tất cả giá trị mẫu.
# Không commit .env.production; tuyệt đối không dùng nguyên các mật khẩu mẫu này.

# Django và tên miền thật
SECRET_KEY=thay-bang-chuoi-ngau-nhien-rieng-dai-va-kho-doan
DEBUG=False
ALLOWED_HOSTS=shop.example.com,www.shop.example.com
CSRF_TRUSTED_ORIGINS=https://shop.example.com,https://www.shop.example.com

# Cơ sở dữ liệu production — cấu hình SQL Server riêng, không dùng DB demo.
DB_ENGINE=mssql
DB_NAME=HUUGIAU_Fashion
DB_HOST=your-sql-server-host
DB_PORT=
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=False
DB_USER=huugiau_app
DB_PASSWORD=thay-bang-mat-khau-db-rieng
DB_EXTRA_PARAMS=Encrypt=yes;TrustServerCertificate=no
MEDIA_ROOT=D:/FashionMedia

# Reverse proxy và HTTPS. Chỉ bật khi proxy đã chuyển tiếp HTTPS đúng cách.
BEHIND_PROXY=True
TRUSTED_PROXY=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Redis production có xác thực; dùng mật khẩu riêng, không dùng lại mật khẩu DB.
REDIS_URL=redis://:thay-bang-mat-khau-redis@127.0.0.1:6379/0
CELERY_BROKER_URL=redis://:thay-bang-mat-khau-redis@127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://:thay-bang-mat-khau-redis@127.0.0.1:6379/2

# SMTP thật để gửi xác nhận đơn, OTP và thông báo; không dùng email cá nhân nếu chưa bảo mật.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=thay-bang-tai-khoan-smtp
EMAIL_HOST_PASSWORD=thay-bang-mat-khau-hoac-app-password-moi
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=HUUGIAU Studio <no-reply@shop.example.com>

# VNPay giữ sandbox cho tới khi có merchant thật và đã kiểm tra callback/IPN HTTPS.
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_REFUND_URL=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# IP duoc phep goi VNPay IPN (tai lieu VNPay, cach nhau dau phay; de trong = chi check chu ky)
VNPAY_ALLOWED_IPS=

# Chuyển khoản thủ công về tài khoản shop. Mặc định tắt để tránh nhận tiền sai.
# SHOP_BANK_CODE là mã ngân hàng nhận (ví dụ ICB = VietinBank), không phải ngân hàng của khách.
# SHOP_ACCOUNT_NAME là tên CHỦ tài khoản đúng theo ngân hàng, không phải tên ngân hàng.
BANK_TRANSFER_ENABLED=False
SHOP_BANK_CODE=ICB
SHOP_BANK_ACCOUNT=
SHOP_ACCOUNT_NAME=

# Thông tin cửa hàng hiển thị công khai — chỉ điền thông tin liên hệ/địa chỉ thật.
HOTLINE=
SUPPORT_EMAIL=support@shop.example.com
STORE_ADDRESS=
PROMO_BANNER=FREESHIP20K

# Tích hợp tùy chọn; để trống nếu chưa đăng ký/cấu hình.
GA4_MEASUREMENT_ID=
GEOAPIFY_API_KEY=
ZALO_OA_ID=
GOOGLE_OAUTH_URL=
FACEBOOK_OAUTH_URL=
APPLE_OAUTH_URL=
COMPRESS_ENABLED=True
