# Production .env template — copy to .env.production và điền giá trị thật.
# KHÔNG commit file .env.production (đã trong .gitignore).
# Lưu file này KHÔNG có comment cuối dòng: settings đọc nguyên giá trị sau dấu '='.

# === Django & Domain (BẮT BUỘC) ===
SECRET_KEY=django-insecure-THAY_BANG_CHUOI_NGAU_NHIEN_50_KY_TU_TRONG_2H
DEBUG=False
DOMAIN=shop.example.com
ALLOWED_HOSTS=shop.example.com,www.shop.example.com
CSRF_TRUSTED_ORIGINS=https://shop.example.com,https://www.shop.example.com
BEHIND_PROXY=True
TRUSTED_PROXY=True
TRUSTED_PROXY_HOPS=2
SECURE_SSL_REDIRECT=True

# === Database (SQL Server production) ===
DB_ENGINE=mssql
DB_NAME=HUUGIAU_Fashion
# IP/host private của SQL Server
DB_HOST=YOUR_SQL_SERVER_HOST
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=False
DB_USER=huugiau_app
DB_PASSWORD=MAT_KHAU_DB_MANH_32_KY_TU
DB_EXTRA_PARAMS=TrustServerCertificate=yes;Encrypt=yes
MEDIA_ROOT=D:/FashionMedia

# === Redis (có mật khẩu, tách DB) ===
REDIS_URL=redis://:MAT_KHAU_REDIS@YOUR_REDIS_HOST:6379/0
CELERY_BROKER_URL=redis://:MAT_KHAU_REDIS@YOUR_REDIS_HOST:6379/1
CELERY_RESULT_BACKEND=redis://:MAT_KHAU_REDIS@YOUR_REDIS_HOST:6379/2

# === Email SMTP (BẮT BUỘC cho production) ===
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@shop.example.com
EMAIL_HOST_PASSWORD=APP_PASSWORD_GMAIL_16_KY_TU
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=HUUGIAU Studio <no-reply@shop.example.com>
ADMIN_ALERT_EMAILS=HUUGIAU Studio:admin@shop.example.com;Tech:tech@shop.example.com
SERVER_EMAIL=alerts@shop.example.com

# === Payment Gateways ===
# Bỏ comment + điền key thật khi đã có merchant. Để trống = ẩn nút ở checkout.
# VNPay
# VNPAY_URL=https://vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_REFUND_URL=https://vnpayment.vn/merchant_webapi/api/transaction
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_ALLOWED_IPS=
# MoMo
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=
# MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
# ZaloPay
# ZALOPAY_APP_ID=
# ZALOPAY_KEY1=
# ZALOPAY_KEY2=
# ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
# ShopeePay
# SHOPEEPAY_PARTNER_ID=
# SHOPEEPAY_KEY=
# SHOPEEPAY_SECRET=
# SHOPEEPAY_ENDPOINT=https://partner.uat.shopeepay.com

# === GHN (vận đơn tự động) ===
# GHN_TOKEN=
# GHN_SHOP_ID=
# GHN_WEBHOOK_TOKEN=

# === Bank transfer (chỉ bật khi có tài khoản thật) ===
BANK_TRANSFER_ENABLED=False
SHOP_BANK_CODE=ICB
SHOP_BANK_ACCOUNT=
SHOP_ACCOUNT_NAME=
SHOP_TAX_ID=

# === Thông tin liên hệ (BẮT BUỘC cho production) ===
HOTLINE=
SUPPORT_EMAIL=
STORE_ADDRESS=
# Đặt True CHỈ sau khi đã kiểm tra hotline/email/địa chỉ thật đang hiển thị đúng.
PUBLIC_CONTACTS_VERIFIED=False

# === Analytics & SEO (tùy chọn) ===
GA4_MEASUREMENT_ID=
GEOAPIFY_API_KEY=
ZALO_OA_ID=
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_TIKTOK=
SOCIAL_YOUTUBE=
BCT_BADGE_URL=
BCT_BADGE_LINK=

# OAuth (chỉ khi cần đăng nhập MXH)
# GOOGLE_OAUTH_URL=https://...
# FACEBOOK_OAUTH_URL=https://...
# APPLE_OAUTH_URL=https://...

# === Monitoring (tùy chọn) ===
SENTRY_DSN=
# Chi bat khi phap ly cho phep gui email/IP khach sang Sentry.
SENTRY_SEND_PII=False
APP_ENV=production

# === Nâng cao ===
SECURE_HSTS_SECONDS=31536000
CONN_MAX_AGE=60
COMPRESS_ENABLED=True
