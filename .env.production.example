# Mẫu Django production. Sao chép thành .env.production và thay tất cả giá trị mẫu.
# Không commit .env.production; tuyệt đối không dùng nguyên các mật khẩu mẫu này.

# Django và tên miền thật
SECRET_KEY=thay-bang-chuoi-ngau-nhien-rieng-dai-va-kho-doan
DEBUG=False
ALLOWED_HOSTS=shop.example.com,www.shop.example.com
CSRF_TRUSTED_ORIGINS=https://shop.example.com,https://www.shop.example.com

# Cơ sở dữ liệu production — cấu hình SQL Server riêng, không dùng DB demo.
DB_ENGINE=mssql
DB_NAME=HUUGIAU_Fashion
DB_HOST=your-sql-server-host
DB_PORT=
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=False
DB_USER=huugiau_app
DB_PASSWORD=thay-bang-mat-khau-db-rieng
DB_EXTRA_PARAMS=Encrypt=yes;TrustServerCertificate=no
MEDIA_ROOT=D:/FashionMedia

# PgBouncer (PostgreSQL connection pooler) — bật nếu dùng PostgreSQL qua pgbouncer
# PGBOUNCER_HOST=pgbouncer
# PGBOUNCER_PORT=6432
# PGBOUNCER_ADMIN_PASSWORD=thay-bang-mat-khau-pgbouncer-admin

# Reverse proxy và HTTPS. Chỉ bật khi proxy đã chuyển tiếp HTTPS đúng cách.
BEHIND_PROXY=True
TRUSTED_PROXY=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Redis production có xác thực; dùng mật khẩu riêng, không dùng lại mật khẩu DB.
REDIS_URL=redis://:thay-bang-mat-khau-redis@127.0.0.1:6379/0
CELERY_BROKER_URL=redis://:thay-bang-mat-khau-redis@127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://:thay-bang-mat-khau-redis@127.0.0.1:6379/2

# SMTP thật để gửi xác nhận đơn, OTP và thông báo; không dùng email cá nhân nếu chưa bảo mật.
# Lay app password: https://myaccount.google.com/apppasswords (bat 2FA truoc).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=thay-bang-tai-khoan-smtp
EMAIL_HOST_PASSWORD=thay-bang-mat-khau-hoac-app-password-moi
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=HUUGIAU Studio <no-reply@shop.example.com>

# VNPay giữ sandbox cho tới khi có merchant thật và đã kiểm tra callback/IPN HTTPS.
# Dang ky sandbox: https://sandbox.vnpayment.vn/devreg/ | Merchant that: https://vnpay.vn
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_REFUND_URL=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# IP duoc phep goi VNPay IPN (tai lieu VNPay, cach nhau dau phay; de trong = chi check chu ky)
VNPAY_ALLOWED_IPS=

# MoMo / ZaloPay / ShopeePay - de trong = tu an nut vi o checkout
# MoMo: https://business.momo.vn | ZaloPay: https://merchant.zalopay.vn | ShopeePay: https://partner.shopeepay.com
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=
# MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
# ZALOPAY_APP_ID=
# ZALOPAY_KEY1=
# ZALOPAY_KEY2=
# ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
# SHOPEEPAY_PARTNER_ID=
# SHOPEEPAY_KEY=
# SHOPEEPAY_SECRET=
# SHOPEEPAY_ENDPOINT=https://partner.uat.shopeepay.com

# GHN: tạo vận đơn COD khi đã điền token/Shop ID, địa chỉ checkout có phường/xã và tỉnh/thành.
GHN_TOKEN=
GHN_SHOP_ID=
# Mặc định production: https://online-gateway.ghn.vn/shiip/public-api
# GHN_BASE_URL=
# Webhook: cấu hình URL /webhook/ghn/ và custom header X-GHN-Token trong GHN Developer Portal.
# Để trống thì webhook bị từ chối.
GHN_WEBHOOK_TOKEN=
# GHTK / ViettelPost - de trong = skip tao don tu dong, giu GHN cu
# GHTK_TOKEN=
# GHTK_SHOP_ID=
# GHTK_ENDPOINT=https://services.giaohangtietkiem.vn/services/shipment/order
# VIETTELPOST_TOKEN=
# VIETTELPOST_SHOP_ID=
# VIETTELPOST_ENDPOINT=https://partner.viettelpost.vn/v2/order/createOrder

# Chuyển khoản thủ công về tài khoản shop. Mặc định tắt để tránh nhận tiền sai.
# SHOP_BANK_CODE là mã ngân hàng nhận (ví dụ ICB = VietinBank), không phải ngân hàng của khách.
# SHOP_ACCOUNT_NAME là tên CHỦ tài khoản đúng theo ngân hàng, không phải tên ngân hàng.
BANK_TRANSFER_ENABLED=False
SHOP_BANK_CODE=ICB
SHOP_BANK_ACCOUNT=
SHOP_ACCOUNT_NAME=

# Thông tin cửa hàng hiển thị công khai — chỉ điền thông tin liên hệ/địa chỉ thật.
HOTLINE=
SUPPORT_EMAIL=
STORE_ADDRESS=
PUBLIC_CONTACTS_VERIFIED=False

# Tích hợp tùy chọn; để trống nếu chưa đăng ký/cấu hình.
# GA4: https://analytics.google.com | Geoapify: https://www.geoapify.com
# Zalo OA: https://oa.zalo.me | BCT dang ky TMDT: http://online.gov.vn
GA4_MEASUREMENT_ID=
GEOAPIFY_API_KEY=
ZALO_OA_ID=
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_TIKTOK=
SOCIAL_YOUTUBE=
BCT_BADGE_URL=
BCT_BADGE_LINK=
# Dang nhap MXH bang URL OAuth (trong = an nut):
# Google: https://console.cloud.google.com/apis/credentials
# Facebook: https://developers.facebook.com/apps
# Apple: https://developer.apple.com/account/resources/identifiers/list/clientID
GOOGLE_OAUTH_URL=
FACEBOOK_OAUTH_URL=
APPLE_OAUTH_URL=
COMPRESS_ENABLED=True
ADMIN_ALERT_EMAILS=

# Monitoring & Search
# Sentry: https://sentry.io — DSN để track lỗi production
SENTRY_DSN=
# Meilisearch: https://www.meilisearch.com — full-text search engine
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=thay-bang-master-key-meilisearch

# Performance
CONN_MAX_AGE=60
SERVER_EMAIL=no-reply@shop.example.com
