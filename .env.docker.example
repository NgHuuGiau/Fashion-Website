# Biến cho Docker Compose local. Sao chép thành .env.docker và thay các mật khẩu mẫu.
# Đây là môi trường phát triển: không dùng secret hoặc dữ liệu này trên production.
APP_ENV_FILE=.env.docker
SECRET_KEY=thay-bang-secret-rieng-chi-dung-local
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Compose dùng PostgreSQL và Redis trong mạng Docker; không sửa DB_ENGINE.
DB_NAME=huugiau_fashion
DB_USER=huugiau
DB_PASSWORD=thay-bang-mat-khau-ngau-nhien
REDIS_PASSWORD=thay-bang-mat-khau-redis-khac
PGBOUNCER_ADMIN_PASSWORD=thay-bang-mat-khau-pgbouncer-khac

# Mail local chỉ in ra console, không gửi email thật.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Thanh toán giữ sandbox và tắt chuyển khoản cho tới khi điền tài khoản shop.
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
BANK_TRANSFER_ENABLED=False
SHOP_BANK_CODE=ICB
SHOP_BANK_ACCOUNT=
SHOP_ACCOUNT_NAME=

# Thông tin cửa hàng và tích hợp tùy chọn.
HOTLINE=
SUPPORT_EMAIL=
STORE_ADDRESS=
PROMO_BANNER=FREESHIP20K
GA4_MEASUREMENT_ID=
ZALO_OA_ID=
