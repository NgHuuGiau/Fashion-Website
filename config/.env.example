# Cấu hình mẫu cho chạy local bằng SQL Server (ODBC Driver 17).
# Sao chép thành .env rồi thay giá trị phù hợp; không điền bí mật thật vào file mẫu.

# Django và tên miền
SECRET_KEY=django-insecure-chi-dung-cho-local-thay-khi-chay-that
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
BEHIND_PROXY=False
TRUSTED_PROXY=False

# Cơ sở dữ liệu local — SQL Server, giữ đúng phiên bản ODBC Driver đang cài.
DB_ENGINE=mssql
DB_NAME=HUUGIAU_Fashion
DB_HOST=.
DB_PORT=
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=True
DB_USER=
DB_PASSWORD=
DB_EXTRA_PARAMS=TrustServerCertificate=yes;Encrypt=no

# Redis là tùy chọn khi phát triển local; production nên dùng Redis có mật khẩu.
REDIS_URL=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Email: để trống máy chủ hoặc dùng console backend để không gửi mail thật.
# Lay app password: https://myaccount.google.com/apppasswords (bat 2FA truoc).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=HUUGIAU Studio <no-reply@localhost>
# Mail nhan canh bao loi 500 (dang "Ten:dia-chi", nhieu nguoi cach nhau ";").
ADMIN_ALERT_EMAILS=Shop:HuuGiau2304@gmail.com

# Thanh toán online — sandbox; chỉ dùng VNPay thật sau khi được cấp merchant.
# Dang ky sandbox: https://sandbox.vnpayment.vn/devreg/ | Merchant that: https://vnpay.vn
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_REFUND_URL=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# IP duoc phep goi VNPay IPN (tai lieu VNPay, cach nhau dau phay; de trong = chi check chu ky)
VNPAY_ALLOWED_IPS=
# Vi dien tu VN - de trong = tu an nut o checkout (sandbox mac dinh)
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=
# MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
# ZALOPAY_APP_ID=
# ZALOPAY_KEY1=
# ZALOPAY_KEY2=
# ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
# SHOPEEPAY_PARTNER_ID=
# SHOPEEPAY_KEY=
# SHOPEEPAY_SECRET=
# SHOPEEPAY_ENDPOINT=https://partner.uat.shopeepay.com
# GHN: điền token và Shop ID thật để checkout tạo vận đơn COD tự động.
# Mặc định DEBUG=True dùng GHN staging, DEBUG=False dùng GHN production.
# GHN_TOKEN=
# GHN_SHOP_ID=
# GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
# Token riêng cho webhook: thêm header X-GHN-Token cùng giá trị trong GHN Developer Portal.
# GHN_WEBHOOK_TOKEN=tao-chuoi-bi-mat-rieng-dai-it-nhat-32-ky-tu
# Ship mo rong - de trong = skip, giu GHN cu
# GHTK_TOKEN=
# GHTK_SHOP_ID=
# VIETTELPOST_TOKEN=
# VIETTELPOST_SHOP_ID=

# Chuyển khoản về MỘT tài khoản của shop; ICB là mã VietinBank.
# Tên chủ tài khoản phải đúng như ngân hàng, không phải tên ngân hàng.
# Chỉ bật sau khi điền mã ngân hàng nhận, số tài khoản và tên chủ tài khoản thật.
BANK_TRANSFER_ENABLED=False
SHOP_BANK_CODE=ICB
SHOP_BANK_ACCOUNT=
SHOP_ACCOUNT_NAME=

# Thông tin liên hệ/cửa hàng hiển thị trên website; điền thông tin đang vận hành thật.
HOTLINE=
SUPPORT_EMAIL=
STORE_ADDRESS=
PUBLIC_CONTACTS_VERIFIED=False

# Tích hợp tùy chọn: để trống nếu chưa sử dụng.
# GA4: https://analytics.google.com | Geoapify: https://www.geoapify.com
# Zalo OA: https://oa.zalo.me | BCT dang ky TMDT: http://online.gov.vn
GA4_MEASUREMENT_ID=
GEOAPIFY_API_KEY=
ZALO_OA_ID=
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_TIKTOK=
SOCIAL_YOUTUBE=
BCT_BADGE_URL=
BCT_BADGE_LINK=
# Dang nhap MXH bang URL OAuth (trong = an nut):
# Google: https://console.cloud.google.com/apis/credentials
# Facebook: https://developers.facebook.com/apps
# Apple: https://developer.apple.com/account/resources/identifiers/list/clientID
GOOGLE_OAUTH_URL=
FACEBOOK_OAUTH_URL=
APPLE_OAUTH_URL=
COMPRESS_ENABLED=False

# Nâng cao (có giá trị mặc định, chỉ đặt khi cần đổi).
# APP_ENV_FILE=.env.production
# MEDIA_ROOT=D:/FashionMedia
# SECURE_HSTS_SECONDS=0
# CONN_MAX_AGE=60
# SERVER_EMAIL=
# ADMIN_ALERT_EMAILS=
# SHOP_TAX_ID=
# PGBOUNCER_HOST=
# PGBOUNCER_PORT=6432
