# === Môi trường & bảo mật ===
# SECRET_KEY bắt buộc cho production. Tạo: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=thay-bang-secret-key-ngau-nhien-dai
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com
DEBUG=False
SECURE_HSTS_SECONDS=31536000

# === Database (mặc định: SQL Server local) ===
DB_ENGINE=mssql
DB_NAME=HUUGIAU_Fashion
DB_HOST=.
DB_PORT=
DB_USER=
DB_PASSWORD=

# === Email (cần để gửi OTP/mail thật — để trống là không gửi) ===
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=app-password-16-ky-tu
DEFAULT_FROM_EMAIL="HUUGIAU Studio <no-reply@yourdomain.com>"

# === Đăng nhập mạng xã hội (URL đăng nhập bên thứ ba / OAuth) ===
GOOGLE_OAUTH_URL=
FACEBOOK_OAUTH_URL=
APPLE_OAUTH_URL=

# === VNPay (sandbox mặc định) ===
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# === Theo dõi & truyền thông ===
GA4_MEASUREMENT_ID=
ZALO_OA_ID=

# === Cấu hình shop (có mặc định trong settings.py) ===
HOTLINE=0932047365
STORE_ADDRESS=Nguyen Huu Tho, Quan 7, TP. Ho Chi Minh
PROMO_BANNER=FREESHIP20K

