{
  "name": "fashion-website-frontend",
  "version": "1.0.0",
  "description": "HUUGIAU Fashion Website Frontend",
  "private": true,
  "scripts": {
    "lint:css": "stylelint \"**/*.css\" --formatter=compact",
    "lint:js": "eslint \"**/*.js\" --format=stylish",
    "lint": "npm run lint:css && npm run lint:js",
    "format:css": "stylelint \"**/*.css\" --fix",
    "format:js": "eslint \"**/*.js\" --fix",
    "format": "npm run format:css && npm run format:js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.1.1",
    "globals": "^15.0.0",
    "stylelint": "^16.3.0",
    "stylelint-config-recess-order": "^5.0.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-scss": "^6.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
