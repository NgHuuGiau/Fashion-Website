# Chỉ dành cho biến Docker Compose, không phải file biến ứng dụng Django.
# Sao chép thành .env.compose.production và thay toàn bộ giá trị mẫu.
APP_ENV_FILE=.env.production
DOMAIN=shop.example.com
ACME_EMAIL=ops@example.com

# Thông tin PostgreSQL, Redis và PgBouncer trong mạng Docker production.
DB_NAME=huugiau_fashion
DB_USER=huugiau
DB_PASSWORD=thay-bang-mat-khau-db-ngau-nhien
REDIS_PASSWORD=thay-bang-mat-khau-redis-khac
PGBOUNCER_ADMIN_PASSWORD=thay-bang-mat-khau-pgbouncer-khac
