# Cấu hình mẫu cho chạy local bằng SQL Server (ODBC Driver 17).
# Sao chép thành .env rồi thay giá trị phù hợp; không điền bí mật thật vào file mẫu.

# Django và tên miền
SECRET_KEY=django-insecure-chi-dung-cho-local-thay-khi-chay-that
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
BEHIND_PROXY=False
TRUSTED_PROXY=False

# Cơ sở dữ liệu local — SQL Server, giữ đúng phiên bản ODBC Driver đang cài.
DB_ENGINE=mssql
DB_NAME=HUUGIAU_Fashion
DB_HOST=.
DB_PORT=
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=True
DB_USER=
DB_PASSWORD=
DB_EXTRA_PARAMS=TrustServerCertificate=yes;Encrypt=no

# Redis là tùy chọn khi phát triển local; production nên dùng Redis có mật khẩu.
REDIS_URL=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Email: để trống máy chủ hoặc dùng console backend để không gửi mail thật.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=HUUGIAU Studio <no-reply@localhost>

# Thanh toán online — sandbox; chỉ dùng VNPay thật sau khi được cấp merchant.
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_REFUND_URL=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# IP duoc phep goi VNPay IPN (tai lieu VNPay, cach nhau dau phay; de trong = chi check chu ky)
VNPAY_ALLOWED_IPS=

# Chuyển khoản về MỘT tài khoản của shop; ICB là mã VietinBank.
# Tên chủ tài khoản phải đúng như ngân hàng, không phải tên ngân hàng.
# Chỉ bật sau khi điền mã ngân hàng nhận, số tài khoản và tên chủ tài khoản thật.
BANK_TRANSFER_ENABLED=False
SHOP_BANK_CODE=ICB
SHOP_BANK_ACCOUNT=
SHOP_ACCOUNT_NAME=

# Thông tin liên hệ/cửa hàng hiển thị trên website; điền thông tin đang vận hành thật.
HOTLINE=
SUPPORT_EMAIL=
STORE_ADDRESS=
PROMO_BANNER=FREESHIP20K

# Tích hợp tùy chọn: để trống nếu chưa sử dụng.
GA4_MEASUREMENT_ID=
GEOAPIFY_API_KEY=
ZALO_OA_ID=
GOOGLE_OAUTH_URL=
FACEBOOK_OAUTH_URL=
APPLE_OAUTH_URL=
COMPRESS_ENABLED=False
