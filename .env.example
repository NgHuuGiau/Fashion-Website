SECRET_KEY=django-insecure-change-me-to-a-real-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database: SQL Server only
DB_ENGINE=mssql
DB_HOST=.
DB_PORT=
DB_NAME=HUUGIAU_Fashion

# Redis (optional, for cache + sessions)
REDIS_URL=

# Compressor
COMPRESS_ENABLED=False

# Email (SMTP). Để trống EMAIL_HOST để tắt gửi mail.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=HUUGIAU Studio <no-reply@huugiau.local>

# Thanh toán VNPay (sandbox mặc định. Điền đủ TMN_CODE + HASH_SECRET để bật).
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# Analytics + Zalo (để trống = tắt trên shop)
GA4_MEASUREMENT_ID=
ZALO_OA_ID=
